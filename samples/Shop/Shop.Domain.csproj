<Project Sdk="Microsoft.NET.Sdk">

  <!-- A small domain model: Orders follows the tactical patterns, Billing has the usual mistakes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TacticaExampleAggregate>samples/Shop/Orders/Order.cs</TacticaExampleAggregate>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tactica" Version="$(TacticaVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
